# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Gemini (default provider). Get a key at https://aistudio.google.com/apikey
# GOOGLE_API_KEY also works (the name the course uses).
GEMINI_API_KEY=

# OpenAI (optional): use with --provider openai or BROCHURE_PROVIDER=openai
OPENAI_API_KEY=

# Optional overrides for week 1
# BROCHURE_PROVIDER=gemini
# BROCHURE_LINK_MODEL=gemini-3.5-flash-lite
# BROCHURE_WRITER_MODEL=gemini-3.8-flash

# Hugging Face Inference Providers (optional, weeks 3+): https://huggingface.co/settings/tokens
HF_TOKEN=

# Week 2 overrides
# FLIGHTAI_PROVIDER=gemini
# FLIGHTAI_MODEL=gemini-3.8-flash
# FLIGHTAI_DB=output/flightai.db

# Week 3 overrides (default: a local model through Ollama)
# MINUTES_PROVIDER=ollama
# MINUTES_MODEL=llama3.2
